# Syncora AI Root Environment Configuration
# ==============================================================================
# Server
# ==============================================================================
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ==============================================================================
# Telegram Bot Integration
# ==============================================================================
TELEGRAM_BOT_TOKEN=MOCK_BOT_TOKEN_FOR_HACKATHON
TELEGRAM_BOT_NAME=@SyncoraAIBot
TELEGRAM_LINKED_GROUP=Nova Studio Core Team (Telegram)
TELEGRAM_ENABLE_POLLING=false
TELEGRAM_POLLING_INTERVAL=2.0

# ==============================================================================
# AI / LLM Provider Abstraction
# ==============================================================================
# Configure ONE of the available providers below to activate real-time LLM reasoning.
# If both keys are left blank, Syncora AI automatically falls back to the deterministic
# heuristic engine, ensuring zero external dependencies during offline hackathon demos.
# Never hard-code API keys into source files!

# 1. Google Gemini API Key (e.g. AIzaSy...)
GEMINI_API_KEY=

# 2. OpenAI API Key (e.g. sk-proj-...)
OPENAI_API_KEY=

# AI Confidence Threshold (0.0 to 1.0)
AI_CONFIDENCE_THRESHOLD=0.75

# ==============================================================================
# Invisible Workload Detector Configurable Thresholds
# ==============================================================================
OVERLOAD_UTILIZATION_THRESHOLD=85.0
UNDERLOAD_UTILIZATION_THRESHOLD=50.0
ANALYSIS_WINDOW_DAYS=7
HIGH_PRIORITY_DENSITY_THRESHOLD=2
OVERDUE_TASK_THRESHOLD=1
DEADLINE_PRESSURE_HOURS=48

# ==============================================================================
# Security & Auth
# ==============================================================================
JWT_SECRET=syncora-college-hackathon-secret-key-2026
LINK_CODE_EXPIRE_SECONDS=600

# ==============================================================================
# Scheduling & Proactive Analysis (Section 9 & 10)
# ==============================================================================
# Enable or disable background scheduler loop (set false for serverless/cron setups)
SCHEDULER_ENABLED=true

# Deterministic scan intervals (seconds)
REMINDERS_INTERVAL_SECONDS=60
WORKLOAD_ANALYSIS_INTERVAL_SECONDS=300
BLOCKER_CHECK_INTERVAL_SECONDS=180
DEADLINE_CHECK_INTERVAL_SECONDS=120

# Snapshot caching and cooldowns
STALE_SNAPSHOT_EXPIRY_MINUTES=30
REMINDER_MIN_COOLDOWN_HOURS=6

# Distributed worker locking TTL (seconds) to prevent duplicate scheduler runs
SCHEDULER_LOCK_TTL_SECONDS=120

# Only notify project leader when meaningful risk changes occur (avoids alert spam)
LEADER_ALERT_MEANINGFUL_CHANGE_ONLY=true
