# Syncora AI — Backend Environment Configuration Example
# Copy this file to .env and supply your credentials. Never commit secrets to source control.

# ==============================================================================
# 1. Server Configuration
# ==============================================================================
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Public URLs used for task links and deep linking
PUBLIC_WEBSITE_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000

# ==============================================================================
# 2. Telegram Bot Integration
# ==============================================================================
# Telegram bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_BOT_NAME=@SyncoraAIBot
TELEGRAM_BOT_USERNAME=SyncoraAIBot
TELEGRAM_LINKED_GROUP=Nova Studio Core Team (Telegram)

# Set to true to enable long-polling in local development without needing ngrok/public webhooks
TELEGRAM_ENABLE_POLLING=true
TELEGRAM_POLLING_INTERVAL=2.0

# Optional Webhook URL (if deploying to production with HTTPS instead of polling)
TELEGRAM_WEBHOOK_URL=

# ==============================================================================
# 3. SMS & Phone Number OTP Verification
# ==============================================================================
# Provider selection: "dev" (sandbox development provider), "twilio", or "fast2sms"
SMS_PROVIDER=dev

# Twilio SMS Configuration (Required if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Fast2SMS Configuration (Required if SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=

# ==============================================================================
# 4. AI / LLM Providers (Shared by Website Chatbox & Telegram Bot)
# ==============================================================================
# If keys are left blank, Syncora AI automatically uses the intelligent, deterministic
# grounded engine that queries real SQLite records without requiring an external API key.

# Google Gemini API Key (e.g. AIzaSy...)
GEMINI_API_KEY=

# OpenAI API Key (e.g. sk-proj-...)
OPENAI_API_KEY=

AI_CONFIDENCE_THRESHOLD=0.75

# ==============================================================================
# 5. Security & Session Management
# ==============================================================================
JWT_SECRET=syncora-college-hackathon-secret-key-2026
LINK_CODE_EXPIRE_SECONDS=600

# ==============================================================================
# 6. Workload Detector Thresholds
# ==============================================================================
OVERLOAD_UTILIZATION_THRESHOLD=85.0
UNDERLOAD_UTILIZATION_THRESHOLD=50.0
ANALYSIS_WINDOW_DAYS=7
HIGH_PRIORITY_DENSITY_THRESHOLD=2
OVERDUE_TASK_THRESHOLD=1
DEADLINE_PRESSURE_HOURS=48
